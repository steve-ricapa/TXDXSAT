# ---------------------------------------------------------------------------
# TXDXSAT environment template. Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=txdx
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=txdxsat

# --- Host ports -------------------------------------------------------------
# Public HTTP port for the frontend (production: Nginx).
HTTP_PORT=8080
# Development-only host ports.
DB_PORT=5433
BACKEND_PORT=4000
FRONTEND_PORT=5173

# --- Backend ----------------------------------------------------------------
LOG_LEVEL=info
# Comma-separated allowed origins. Empty = same-origin only in production.
CORS_ORIGINS=
# Event dispatcher tuning.
DISPATCHER_ENABLED=true
DISPATCHER_INTERVAL_MS=1000
DISPATCHER_BATCH_SIZE=25
DISPATCHER_MAX_ATTEMPTS=10
DISPATCHER_LEASE_MS=30000
# Apply Prisma migrations on container start.
RUN_MIGRATIONS=true

# --- Media storage (Fase 3) -------------------------------------------------
# Directory inside the backend container where uploaded images are stored. It
# MUST be backed by the `txdxsat_uploads` Docker volume (see compose.yaml) or the
# files vanish on rebuild. See docs/storage.md.
STORAGE_DRIVER=local
STORAGE_DIR=/app/storage
# Maximum size per uploaded image, in bytes (default 5 MB).
STORAGE_MAX_BYTES=5242880
# Public prefix under which uploaded images are served (capability URLs).
STORAGE_PUBLIC_PREFIX=/api/v1/media

# --- Auth (login) -----------------------------------------------------------
# Login sessions are opaque bearer tokens (only their hash is stored server-side).
SESSION_TTL_HOURS=720
# First superadmin, created automatically at startup ONLY while the platform has
# no accounts. Change the password, or clear these to skip and seed manually with
# `npm run seed:superadmin` inside backend/.
SUPERADMIN_EMAIL=admin@txdxsat.local
SUPERADMIN_PASSWORD=change-me-superadmin
SUPERADMIN_NAME=Super Admin

# --- Backend (local, non-Docker) --------------------------------------------
# Used when running `npm run dev` directly against the published dev database.
DATABASE_URL=postgresql://txdx:txdx@localhost:5433/txdxsat?schema=public

# --- Frontend (build-time) --------------------------------------------------
VITE_BASE_PATH=/sat/
VITE_APP_NAME=TXDXSAT
# Optional overrides; by default derived from the base path at runtime.
# VITE_API_BASE_URL=/sat/api/v1
# VITE_SOCKET_PATH=/sat/socket.io
# VITE_SOCKET_URL=
# Development proxy target when running Vite outside Docker.
VITE_DEV_API_TARGET=http://localhost:4000

# Demo tenants/users/quizzes are created only when explicitly enabled.
SEED_DEMO_DATA=false
