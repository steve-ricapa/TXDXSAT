# ---------------------------------------------------------------------------
# TXDXSAT environment template. Copy to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=txdx
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=txdxsat

# --- Host ports -------------------------------------------------------------
# Public HTTP port for the frontend (production: Nginx).
HTTP_PORT=8080
# Development-only host ports.
DB_PORT=5433
BACKEND_PORT=4000
FRONTEND_PORT=5173

# --- Backend ----------------------------------------------------------------
LOG_LEVEL=info
# Comma-separated allowed origins. Empty = same-origin only in production.
CORS_ORIGINS=
# Event dispatcher tuning.
DISPATCHER_ENABLED=true
DISPATCHER_INTERVAL_MS=1000
DISPATCHER_BATCH_SIZE=25
DISPATCHER_MAX_ATTEMPTS=10
DISPATCHER_LEASE_MS=30000
# Apply Prisma migrations on container start.
RUN_MIGRATIONS=true

# --- Backend (local, non-Docker) --------------------------------------------
# Used when running `npm run dev` directly against the published dev database.
DATABASE_URL=postgresql://txdx:txdx@localhost:5433/txdxsat?schema=public

# --- Frontend (build-time) --------------------------------------------------
VITE_BASE_PATH=/sat/
VITE_APP_NAME=TXDXSAT
# Optional overrides; by default derived from the base path at runtime.
# VITE_API_BASE_URL=/sat/api/v1
# VITE_SOCKET_PATH=/sat/socket.io
# VITE_SOCKET_URL=
# Development proxy target when running Vite outside Docker.
VITE_DEV_API_TARGET=http://localhost:4000
